---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/Window.astro';
import NoteOutline from '../../components/NoteOutline.astro';
import { kbMeta, metaSegments } from '../../lib/kb';

export async function getStaticPaths() {
  const entries = await getCollection('kb');
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const meta = kbMeta(entry);
const title = meta.title;
const moduleName = meta.subjectLabel;
// 面包屑末段用清洗后的标题：id 里可能带章节前缀与 OCR 逐字连字符（第05章-公-文-知-识）
const breadcrumb = entry.id.split('/').map((p) => p.replace(/^\d+-/, ''));
breadcrumb[breadcrumb.length - 1] = title;
const crumbTrail = metaSegments(meta.subjectLabel, meta.moduleLabel, meta.type);
---

<BaseLayout title={`${title} | 考编知识库`} description={`${moduleName} · ${title}`}>
  <Window
    id="kb-note"
    title={`笔记 - ${title}`}
    icon="📄"
    x={80}
    y={40}
    width={780}
    height={580}
    active
    maximized
    bodyClass="note-split"
  >
    <article class="kb-md">
      <nav class="kb-crumb text-win-text-muted">
        <a href="/kb">考编知识库</a>
        {
          breadcrumb.map((b, i) => (
            <span> / {i === breadcrumb.length - 1 ? <strong>{b}</strong> : b}</span>
          ))
        }
      </nav>
      <h1>{title}</h1>
      <p class="kb-note-meta">
        {
          crumbTrail.map((seg, i) => (
            <>
              {i > 0 && <span class="kb-note-sep"> · </span>}
              <span>{seg}</span>
            </>
          ))
        }
        {
          meta.source && (
            <>
              <span class="kb-note-sep"> · </span>
              <a
                class="kb-note-src"
                href={`/kb/browse?source=${encodeURIComponent(meta.source)}`}
                title={`按来源「${meta.source}」筛选`}
              >
                来源：{meta.source}
              </a>
            </>
          )
        }
      </p>
      <p class="kb-note-actions">
        <a href={`/kb/browse?subject=${encodeURIComponent(meta.subject)}`} class="pixel-btn">
          同模块
        </a>
        <a href={`/kb/browse?type=${encodeURIComponent(meta.type)}`} class="pixel-btn">
          同类型
        </a>
        <a href="/kb/browse" class="pixel-btn">分面浏览</a>
      </p>
      <hr class="border-t-2 border-dashed border-purple-500 my-[18px]" />
      <Content />
    </article>
    <NoteOutline headings={headings} />
  </Window>
</BaseLayout>
