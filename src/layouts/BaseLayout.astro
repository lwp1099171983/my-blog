---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import DesktopIcons from '../components/DesktopIcons.astro';
import Taskbar from '../components/Taskbar.astro';
import { SITE } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = SITE.name,
  description = SITE.description,
  ogImage = undefined,
  ogType = undefined,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
  </head>
  <body>
    <div class="desktop-bg" aria-hidden="true"></div>

    <DesktopIcons />

    <slot />

    <footer class="site-footer">
      <a
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
      >闽ICP备2026032080号</a>
    </footer>

    <Taskbar />

    <script>
      import '../scripts/window-manager.js';
    </script>
  </body>
</html>
