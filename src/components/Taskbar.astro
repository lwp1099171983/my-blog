---
import Win98Button from './Win98Button.astro';
---

<div class="taskbar">
  <Win98Button
    class="taskbar-start"
    type="button"
    onclick="window.location.href='/'"
    aria-label="首页"
  >
    <span class="start-icon" aria-hidden="true">⭐</span>
    首页
  </Win98Button>

  <div class="taskbar-tabs" id="taskbarTabs"></div>

  <div class="taskbar-clock" id="taskbarClock" aria-live="polite">00:00</div>
</div>
