---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  showCategory?: boolean;
}

const { post, showCategory = false } = Astro.props;
const { title, date, tags, category, slug } = post.data;
---

<a class="post-item" href={`/posts/${slug}`}>
  <span class="font-pixel text-fs-small text-win-text-muted mr-2">{date}</span>
  <span class="font-body text-fs-body text-[var(--card-text)]">{title}</span>
  {
    showCategory && category && (
      <span class="font-pixel text-fs-small text-win-text-muted ml-auto">
        {category}
      </span>
    )
  }
</a>
