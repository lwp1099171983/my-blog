---
import WindowControls from './WindowControls.astro';

interface Props {
  id: string;
  title: string;
  icon?: string;
  x?: number;
  y?: number;
  width?: number;
  height?: number;
  hidden?: boolean;
  active?: boolean;
  maximized?: boolean;
  /** 追加到 .window-body 的类名，例如让内容随窗口高度伸缩的 kb-fill */
  bodyClass?: string;
}

const {
  id,
  title,
  icon = '▣',
  x = 120,
  y = 96,
  width = 520,
  height = 360,
  hidden = false,
  active = true,
  maximized = false,
  bodyClass = '',
} = Astro.props;

const style = [
  `top:${y}px`,
  `left:${x}px`,
  `width:${width}px`,
  `height:${height}px`,
  hidden ? 'display:none' : '',
]
  .filter(Boolean)
  .join(';');
---

<div
  id={`win-${id}`}
  class:list={['window', { active, maximized }]}
  style={style}
>
  <div class="titlebar" data-window={id}>
    <span class="titlebar-icon" aria-hidden="true">{icon}</span>
    <span class="titlebar-text">{title}</span>
    <WindowControls windowId={id} />
  </div>
  <div class:list={['window-body', bodyClass]}>
    <slot />
  </div>
  {
    /* 缩放把手：四边 + 四角。右下角那块同时是 Win98 的点状抓手。
       纯鼠标/触摸交互，键盘无法操作，故对辅助技术隐藏。 */
    ['n', 's', 'e', 'w', 'nw', 'ne', 'sw', 'se'].map((dir) => (
      <div class="window-resize" data-resize={dir} aria-hidden="true" />
    ))
  }
</div>
